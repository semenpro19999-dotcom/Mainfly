# Адрес твоего сервера Minecraft Fabric 1.20.1
# Если сервер запущен на этом же компьютере: localhost
MC_HOST=localhost

# Порт сервера (по умолчанию в Minecraft 25565, а при открытии мира для сети обычно 5-значный, например 51234)
MC_PORT=25565

# Никнейм, под которым бот зайдет в игру
MC_USERNAME=Drosophila_Fly
